# Server
PORT=5000

# MongoDB (teammate will provide the real connection string)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/lostfound

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=5

# College email restriction — only addresses ending in this domain can register/login
COLLEGE_EMAIL_DOMAIN=@sru.edu.in

# The one email allowed to view the full report list (room 8001 coordinator)
ADMIN_EMAIL=admin@sru.edu.in

# SMTP (for sending OTP mails) — use your college/Gmail SMTP or a service like Gmail App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Campus Lost & Found <your_sender_email@gmail.com>"

# Optional comma-separated frontend origins for separate hosting. Empty = same-origin only.
CORS_ORIGINS=
